rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Commercial property photographs are publicly readable because the
    // matching listings are public on /portfolio.html. Uploads remain owner-scoped.
    match /commercialPropertyImages/{userId}/{propertyId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.propertyId == propertyId;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Residential listing photos: owners upload into their own property folder; published portfolio photos are publicly readable.
    // Residential listing photos: owners upload into their own property folder; published portfolio photos are publicly readable.
    // Residential listing photos: owners upload into their own property folder; published portfolio photos are publicly readable.
    match /residentialPropertyImages/{userId}/{propertyId}/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 8 * 1024 * 1024
        && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp']
        && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')
        && request.resource.metadata.ownerUid == request.auth.uid
        && request.resource.metadata.propertyId == propertyId;
      allow update: if false;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Message files are accessible only to authenticated participants in the corresponding Firestore directMessages record.
    match /messageAttachments/{messageId}/{fileId}/{fileName} {
      function messageDoc() {
        return firestore.get(/databases/(default)/documents/directMessages/$(messageId));
      }
      function isParticipant() {
        return request.auth != null
          && messageDoc().data.participants is list
          && request.auth.uid in messageDoc().data.participants;
      }
      allow read: if isParticipant();
      allow create: if request.auth != null
        && messageDoc().data.senderUid == request.auth.uid
        && request.resource.size <= 2 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-word.document.macroEnabled.12',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.template',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'application/vnd.ms-excel.sheet.macroEnabled.12',
          'application/vnd.ms-excel.template.macroEnabled.12',
          'application/vnd.ms-excel.sheet.binary.macroEnabled.12',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.template',
          'text/csv',
          'application/csv',
          'application/rtf',
          'text/rtf'
        ]
        && request.resource.name.matches('.*\\.(pdf|doc|docx|docm|dot|dotx|dotm|xls|xlsx|xlsm|xlsb|xlt|xltx|xltm|csv|rtf)$');
      allow update: if false;
      allow delete: if request.auth != null
        && messageDoc().data.senderUid == request.auth.uid;
    }

    // Broker social feed attachments: image files and PDFs only, uploaded by the
    // owner of the post. Files are readable only by authenticated community members.
    match /brokerPostAttachments/{userId}/{postId}/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 10 * 1024 * 1024
        && !request.resource.name.matches('.*\\.(doc|docx|docm|dot|dotx|dotm|xls|xlsx|xlsm|xlsb|xlt|xltx|xltm|csv|rtf)$')
        && (
          (
            request.resource.contentType == 'application/pdf'
            && request.resource.name.matches('.*\\.pdf$')
          )
          ||
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.name.matches('.*\\.[A-Za-z0-9]{2,8}$')
          )
        );
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }


    // Hamlet transaction documents are restricted to the owning broker and to
    // a transaction document they own. Download access remains authenticated.
    match /hamletDocuments/{userId}/{dealId}/{documentId}/{fileName} {
      function ownedDeal() {
        return firestore.get(/databases/(default)/documents/hamletDeals/$(dealId)).data.uid == userId;
      }
      allow read: if request.auth != null
        && request.auth.uid == userId
        && ownedDeal();
      allow create: if request.auth != null
        && request.auth.uid == userId
        && ownedDeal()
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv',
          'text/plain',
          'image/png',
          'image/jpeg',
          'image/webp'
        ]
        && request.resource.name.matches('.*\\.(pdf|doc|docx|xls|xlsx|csv|txt|png|jpg|jpeg|webp)$');
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == userId
        && ownedDeal();
    }


    // Tenant-scoped organisation files. Every object is linked to a Firestore
    // organisationDocuments record and a parent deal or property.
    match /organisationDocuments/{organisationId}/{resourceType}/{resourceId}/{documentId}/{fileName} {
      function memberPath() {
        return /databases/(default)/documents/organisationMembers/$(organisationId + '_' + request.auth.uid);
      }
      function organisationPath() {
        return /databases/(default)/documents/organisations/$(organisationId);
      }
      function parentPath() {
        return /databases/(default)/documents/$(resourceType == 'deal' ? 'organisationDeals' : 'organisationProperties')/$(resourceId);
      }
      function sharePath() {
        return /databases/(default)/documents/organisationResourceShares/$(organisationId + '_' + resourceType + '_' + resourceId + '_' + request.auth.uid);
      }
      function activeMember() {
        return request.auth != null
          && firestore.exists(memberPath())
          && firestore.get(memberPath()).data.uid == request.auth.uid
          && firestore.get(memberPath()).data.organisationId == organisationId
          && firestore.get(memberPath()).data.status == 'active'
          && firestore.exists(organisationPath())
          && firestore.get(organisationPath()).data.status == 'active';
      }
      function parentExists() {
        return resourceType in ['deal', 'property'] && firestore.exists(parentPath());
      }
      function parentData() {
        return firestore.get(parentPath()).data;
      }
      function manager() {
        return activeMember()
          && firestore.get(memberPath()).data.role in ['owner', 'admin', 'manager'];
      }
      function canReadParent() {
        return activeMember() && parentExists()
          && (
            parentData().visibility == 'organisation'
            || parentData().createdByUid == request.auth.uid
            || (parentData().sharedWithUids is list && request.auth.uid in parentData().sharedWithUids)
            || firestore.exists(sharePath())
            || manager()
          );
      }
      function canWriteParent() {
        return activeMember() && parentExists()
          && (
            manager()
            || (parentData().createdByUid == request.auth.uid
              && firestore.get(memberPath()).data.role == 'member')
          );
      }
      function validFileMetadata() {
        return request.resource.metadata.organisationId == organisationId
          && request.resource.metadata.resourceType == resourceType
          && request.resource.metadata.resourceId == resourceId
          && request.resource.metadata.documentId == documentId
          && request.resource.metadata.uploaderUid == request.auth.uid;
      }
      allow read: if canReadParent();
      allow create: if canWriteParent()
        && validFileMetadata()
        && request.resource.size > 0
        && request.resource.size <= 15 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document',
          'application/vnd.ms-excel',
          'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
          'text/csv',
          'text/plain',
          'image/png',
          'image/jpeg',
          'image/webp'
        ]
        && request.resource.name.matches('.*\\.(pdf|doc|docx|xls|xlsx|csv|txt|png|jpg|jpeg|webp)
      allow read, write: if false;
    }
  }
}
);
      allow update: if false;
      allow delete: if canWriteParent()
        && resource.metadata.organisationId == organisationId
        && resource.metadata.resourceType == resourceType
        && resource.metadata.resourceId == resourceId
        && resource.metadata.documentId == documentId;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
